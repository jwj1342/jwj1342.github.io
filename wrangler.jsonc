{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wenjia-me",
  "compatibility_date": "2026-11-01",
  // The site's own address. Cloudflare creates the DNS record and certificate for it.
  // (www.wenjia.me is redirected here by a redirect rule on the zone, not by this Worker.)
  "routes": [{ "pattern": "wenjia.me", "custom_domain": true }],
  // Keep the wenjia-me.<account>.workers.dev address working as a second way in.
  "workers_dev": true,
  // Lets `npx wrangler versions upload --preview-alias <name>` publish a try-out copy at
  // <name>-wenjia-me.<account>.workers.dev without touching the live site.
  "preview_urls": true,
  // The pages are static files in dist/. Only /api/* runs code (worker/index.ts): the
  // visitor log and the data for the visitor map. Every other address is served straight
  // from the files without starting the Worker.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Where the visitor log is kept. Tables are in migrations/ (`npm run db:migrate`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wenjia-me",
      "database_id": "6c46c800-2e9e-4dd7-8de7-5f676d9a2567",
      "migrations_dir": "migrations"
    }
  ],
  // About this many /api/* requests a minute from one visitor (counted by IP address);
  // more are answered with 429. A real visit makes two or three per page. Cloudflare
  // enforces it loosely: each of its machines counts by itself, so a flood is slowed
  // down, not stopped. `namespace_id` only has to be a number of our choosing.
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  // Once a day, at 01:00 UTC (09:00 in Beijing), the Worker checks how full the visitor
  // log is and emails a warning if it needs attention (dailyCheck in worker/index.ts).
  "triggers": { "crons": ["0 1 * * *"] },
  // Lets the Worker send that email, from an address on wenjia.me. The domain must be
  // onboarded to Cloudflare Email Service and the recipient verified there.
  "send_email": [{ "name": "EMAIL" }],
  // Keeps the Worker's own log lines (errors) readable in the dashboard.
  "observability": { "enabled": true }
}
