{
  "name": "wenjia-me",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "translate": "node scripts/translate.mjs",
    "photos:add": "node scripts/photos.mjs",
    "photos:remove": "node scripts/photos.mjs --remove",
    "model:mirror": "node scripts/mirror-model.mjs",
    "db:migrate": "wrangler d1 migrations apply wenjia-me --remote",
    "logs:views": "wrangler d1 execute wenjia-me --remote --command \"SELECT * FROM page_views LIMIT 50\"",
    "logs:export": "wrangler d1 export wenjia-me --remote --output=logs-backup.sql",
    "logs:chat": "wrangler d1 execute wenjia-me --remote --command \"SELECT * FROM chat_log LIMIT 50\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.8",
    "@astrojs/mdx": "^8.1.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.88",
    "astro": "^7.4.11",
    "katex": "^0.19.1",
    "photoswipe": "^5.4.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.2",
    "exifr": "^7.1.3",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.160.1"
  }
}
