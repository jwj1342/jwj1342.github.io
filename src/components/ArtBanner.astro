---
/**
 * A Monet painting across the top of a page, fading out into the page background so
 * the heading below sits on its lower edge. Purely decorative.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  /** Shown as a small, faint caption, e.g. "Impression, Sunrise" */
  title: string;
  /** CSS object-position, to choose which part of the painting shows */
  focus?: string;
  /** Match pages whose content column is wider than usual (the photo wall). */
  wide?: boolean;
}
const { image, title, focus = '50% 50%', wide = false } = Astro.props;
---

<div class="art" aria-hidden="true">
  <Image
    src={image}
    alt=""
    widths={[640, 1100, 1600]}
    sizes="100vw"
    quality={55}
    loading="eager"
    fetchpriority="high"
    style={`object-position:${focus}`}
  />
</div>
<p class:list={['wrap', 'credit', { wide }]}>
  <span>{title}</span>
</p>

<style>
  .art {
    height: clamp(11rem, 30vw, 21rem);
    /* fade to nothing at the bottom, so the page background takes over */
    -webkit-mask-image: linear-gradient(to bottom, #000 30%, rgba(0, 0, 0, 0.55) 62%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 30%, rgba(0, 0, 0, 0.55) 62%, transparent 100%);
    opacity: 0.92;
    overflow: hidden;
    background: var(--line);
  }
  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* at night the painting is dimmed so it does not glare */
  :global(:root[data-theme='dark']) .art {
    opacity: 0.62;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .art {
      opacity: 0.62;
    }
  }
  .credit {
    /* sits on the faded lower edge of the painting, pulling the page heading up with it */
    margin-top: clamp(-5.5rem, -9vw, -3rem);
    margin-bottom: 0;
    position: relative;
    display: flex;
    justify-content: flex-end;
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.82rem;
    color: var(--muted);
    opacity: 0.7;
  }
  .credit.wide {
    --measure: 84rem;
  }
  .credit span {
    padding: 0.15rem 0;
  }
</style>
