---
import { citations, repoSlug, repoStars } from '../lib/metrics';
import { formatCount } from '../lib/metrics-format';

interface Props {
  links: { paper?: string; pdf?: string; project?: string; code?: string };
  doi?: string;
}
const { links, doi } = Astro.props;
const repo = repoSlug(links.code);
const stars = await repoStars(links.code);
const cites = await citations(doi);
// One button for the paper itself: the arXiv page when there is one, otherwise the
// publisher's page (or a bare PDF link as a last resort).
const paperUrl = links.paper ?? links.pdf;
const isArxiv = !!paperUrl?.includes('arxiv.org');
const any = paperUrl || links.project || links.code || cites !== null;
---

{
  any && (
    <div class="pub-links">
      {paperUrl && (
        <a class="btn primary" href={paperUrl} target="_blank" rel="noopener">
          {isArxiv ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
              <path d="M5 4l14 16" stroke-width="3.4" />
              <path d="M19 4L5 20" stroke-width="1.5" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
              <path d="M14 3v5h5M9 13h6M9 17h4" />
            </svg>
          )}
          {isArxiv ? 'arXiv' : 'Paper'}
        </a>
      )}
      {links.code && (
        <a
          class="btn stars"
          href={links.code}
          target="_blank"
          rel="noopener"
          data-stars-repo={repo}
          title={stars !== null ? `${stars.toLocaleString('en-US')} ${stars === 1 ? 'star' : 'stars'} on GitHub` : 'Code on GitHub'}
        >
          <svg class="gh" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z" />
          </svg>
          <span class="sr-only">Code on GitHub, </span>
          <svg class="star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 3.2l2.7 5.6 6.1.8-4.5 4.3 1.1 6.1-5.4-3-5.4 3 1.1-6.1-4.5-4.3 6.1-.8z" />
          </svg>
          <span data-num>{stars !== null ? formatCount(stars) : 'Star'}</span>
          <span class="sr-only" data-word> {stars === 1 ? 'star' : 'stars'}</span>
        </a>
      )}
      {links.project && (
        <a class="btn" href={links.project} target="_blank" rel="noopener">
          Project page
        </a>
      )}
      {doi && (
        <span
          class="cites"
          data-cites-doi={doi}
          hidden={!cites}
          title={`${(cites ?? 0).toLocaleString('en-US')} ${cites === 1 ? 'citation' : 'citations'} (OpenAlex)`}
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.500 10.500A3.500 3.500 0 1 1 10 14v.500C10 16.900 8.400 18.600 6 19l-.500-1.300c1.300-.400 2-1.200 2.200-2.300A3.500 3.500 0 0 1 6.500 10.500zm8 0A3.500 3.500 0 1 1 18 14v.500c0 2.400-1.600 4.100-4 4.500l-.500-1.300c1.300-.400 2-1.200 2.200-2.300a3.500 3.500 0 0 1-1.200-4.900z" />
          </svg>
          <span data-num>{formatCount(cites ?? 0)}</span>
          <span data-word>{cites === 1 ? 'citation' : 'citations'}</span>
        </span>
      )}
    </div>
  )
}

<style>
  .pub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .btn > svg {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }
  /* the paper is what most visitors want: filled, and a size up */
  .btn.primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
    font-size: 0.98rem;
    font-weight: 600;
    padding: 0 1.25rem;
  }
  .btn.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .btn.stars {
    font-variant-numeric: tabular-nums;
  }
  .btn.stars .star {
    width: 0.95rem;
    height: 0.95rem;
    color: #d9a400;
    margin-left: 0.1rem;
  }
  /* a statistic, not an action: plain text that lines up with the buttons */
  .cites {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    padding: 0 0.35rem;
    font-size: 0.9rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cites[hidden] {
    display: none;
  }
  .cites svg {
    width: 1rem;
    height: 1rem;
    opacity: 0.7;
  }
  .cites [data-num] {
    color: var(--ink);
    font-weight: 600;
  }
</style>

<script>
  import '../scripts/live-metrics';
</script>
