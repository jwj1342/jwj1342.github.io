---
interface Props {
  index?: string;
  title: string;
  id?: string;
}
const { index, title, id } = Astro.props;
---

<section id={id}>
  <div class="sec">
    <h2>{index && <small>{index}</small>}{title}</h2>
    <div class="body"><slot /></div>
  </div>
</section>

<style>
  section {
    border-top: 1px solid var(--line);
    padding: clamp(2.25rem, 5vw, 4rem) 0;
  }
  .sec {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    margin: 0;
    line-height: 1.2;
  }
  h2 small {
    display: block;
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .body {
    min-width: 0;
  }
  @media (min-width: 52rem) {
    .sec {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 3rem;
    }
    h2 {
      position: sticky;
      top: calc(var(--header-h) + 1.75rem);
      align-self: start;
    }
  }
</style>
