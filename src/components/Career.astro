---
/**
 * Career drawn as `git log --graph`: a main line of commits, with side branches for
 * things done alongside it. Each entry shows the advisor (linked) and the role.
 */
import { career } from '../data/career';

const entries = career;
---

<div class="log">
  <p class="prompt" aria-hidden="true"><span>$</span> git log --graph career</p>
  <ol>
    {
      entries.map((e, i) => (
        <li class:list={{ side: e.lane === 1, first: i === 0, last: i === entries.length - 1 }}>
          <div class="graph" aria-hidden="true">
            <span class="rail" />
            {e.lane === 1 && (
              <>
                {e.merged && (
                  <svg class="curve merge" viewBox="0 0 16 12" preserveAspectRatio="none">
                    <path d="M0 0 C0 8 16 4 16 12" />
                  </svg>
                )}
                <span class="branch" />
                <svg class="curve fork" viewBox="0 0 16 12" preserveAspectRatio="none">
                  <path d="M16 0 C16 8 0 4 0 12" />
                </svg>
              </>
            )}
            <span class="node" />
          </div>
          <span class:list={['mark', { logo: !!e.logo }]} aria-hidden="true">
            {e.logo ? <img src={`/images/logos/${e.logo}`} alt="" width="96" height="96" loading="lazy" decoding="async" /> : e.mark}
          </span>
          <div class="body">
            <h3>{e.org}</h3>
            <p class="commit">
              <span class="line">
                {e.advisors?.map((a) =>
                  a.url ? (
                    <a class="advisor" href={a.url} target="_blank" rel="noopener">
                      @{a.name}
                    </a>
                  ) : (
                    <span class="advisor">@{a.name}</span>
                  ),
                )}
                <span class="msg">{e.role}</span>
              </span>
              <time>{e.when}</time>
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .log {
    --x0: 0.6rem; /* main line */
    --x1: 2.2rem; /* side branch */
    --node-y: 1.05rem; /* centre of the commit dot, level with the first text line */
    --rail: color-mix(in srgb, var(--accent) 55%, transparent);
    --rail-side: color-mix(in srgb, var(--accent-2) 70%, transparent);
  }
  .prompt {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .prompt {
    margin-bottom: 1.1rem;
  }
  .prompt span {
    color: var(--accent);
    margin-right: 0.35em;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 3.1rem 2.75rem minmax(0, 1fr);
    column-gap: 0.85rem;
  }

  /* ---- the graph ---- */
  .graph {
    position: relative;
  }
  .rail,
  .branch {
    position: absolute;
    width: 2px;
    margin-left: -1px;
  }
  .rail {
    left: var(--x0);
    top: 0;
    bottom: 0;
    background: var(--rail);
  }
  li.first .rail {
    top: var(--node-y);
  }
  li.last .rail {
    bottom: auto;
    height: var(--node-y);
  }
  .branch {
    left: var(--x1);
    top: var(--node-y);
    bottom: 1.5rem;
    background: var(--rail-side);
  }
  .curve {
    position: absolute;
    left: var(--x0);
    width: calc(var(--x1) - var(--x0));
    overflow: visible;
  }
  .curve path {
    fill: none;
    stroke: var(--rail-side);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .curve.fork {
    bottom: 0;
    height: 1.5rem;
  }
  .curve.merge {
    top: 0;
    height: var(--node-y);
  }
  .node {
    position: absolute;
    left: var(--x0);
    top: var(--node-y);
    width: 0.8rem;
    height: 0.8rem;
    margin: -0.4rem 0 0 -0.4rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  li.side .node {
    left: var(--x1);
    border-color: var(--accent-2);
  }
  /* HEAD is the filled dot */
  li.first .node {
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  /* ---- the entry ---- */
  .mark {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--surface);
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .mark.logo {
    background: #ffffff;
    overflow: hidden;
  }
  .mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .body {
    padding-bottom: 1.6rem;
    min-width: 0;
  }
  li.last .body {
    padding-bottom: 0.6rem;
  }
  h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.1rem, 1.9vw, 1.25rem);
    line-height: 1.3;
    margin: 0.1rem 0 0.3rem;
  }
  .commit {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.1rem 1.25rem;
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--ink);
  }
  /* the advisor sits where a commit hash would, and links to their homepage */
  .advisor {
    margin-right: 0.6em;
    color: var(--accent-2);
    text-decoration: none;
    white-space: nowrap;
  }
  a.advisor:hover {
    color: var(--accent-2);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  time {
    font-size: 0.78rem;
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 36rem) {
    .log {
      --x0: 0.5rem;
      --x1: 1.6rem;
    }
    li {
      grid-template-columns: 2.3rem 2.1rem minmax(0, 1fr);
      column-gap: 0.6rem;
    }
    .mark {
      width: 2.1rem;
      height: 2.1rem;
      border-radius: 0.45rem;
      font-size: 0.6rem;
      margin-top: 0.1rem;
    }
  }
</style>
