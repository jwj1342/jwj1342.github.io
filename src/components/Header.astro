---
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">{site.name}</a>
    <div class="actions">
      <nav aria-label="Main">
        <ul id="nav-list">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={!item.external && isCurrent(item.href) ? 'page' : undefined}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch colour theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
        </svg>
      </button>
      <button class="icon-btn menu-btn" id="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-list">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeBtn = document.getElementById('theme-toggle');
  const systemDark = matchMedia('(prefers-color-scheme: dark)');
  let fadeTimer: number | undefined;
  const currentTheme = () => root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');

  function label() {
    const text = currentTheme() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
    themeBtn?.setAttribute('aria-label', text);
    themeBtn?.setAttribute('title', text);
  }
  function apply(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    const colour = theme === 'dark' ? '#0e1717' : '#f5f5f0';
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => {
      m.removeAttribute('media');
      m.content = colour;
    });
    label();
  }

  themeBtn?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', next);
    } catch {}
    // Fade colours for a moment instead of snapping. The theme itself is applied
    // synchronously, so quick repeated clicks always toggle correctly.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('theme-fade');
      clearTimeout(fadeTimer);
      fadeTimer = window.setTimeout(() => root.classList.remove('theme-fade'), 350);
    }
    apply(next);
  });
  // If no theme was chosen by hand, the page follows the system; keep the label right.
  systemDark.addEventListener('change', label);
  // Another tab changed the theme: follow it.
  addEventListener('storage', (e) => {
    if (e.key === 'theme' && (e.newValue === 'light' || e.newValue === 'dark')) apply(e.newValue);
  });
  label();

  const menuBtn = document.getElementById('menu-toggle');
  const list = document.getElementById('nav-list');
  menuBtn?.addEventListener('click', () => {
    const open = list?.classList.toggle('open') ?? false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    position: relative;
  }
  .brand {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: -0.01em;
    padding: 0.5rem 0;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  ul {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    list-style: none;
    margin: 0 0.75rem 0 0;
    padding: 0;
    font-size: 0.9rem;
  }
  ul a {
    text-decoration: none;
    color: var(--muted);
    padding: 0.75rem 0;
    display: inline-block;
  }
  ul a[aria-current],
  ul a:hover {
    color: var(--ink);
  }
  ul a[aria-current] {
    box-shadow: inset 0 -1px var(--accent);
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--ink);
  }
  .icon-btn svg {
    width: 1.3rem;
    height: 1.3rem;
  }
  .menu-btn {
    display: none;
    margin-right: -0.7rem;
    color: var(--ink);
  }
  /* show the icon for the theme you would switch TO */
  .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }
  }

  @media (max-width: 44rem) {
    .menu-btn {
      display: grid;
    }
    ul {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      gap: 0;
      margin: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      padding: 0.25rem var(--gutter) 0.75rem;
    }
    ul.open {
      display: flex;
    }
    ul a {
      display: block;
      padding: 0.85rem 0;
      font-size: 1.05rem;
      border-top: 1px solid var(--line);
      box-shadow: none;
    }
    ul a[aria-current] {
      box-shadow: none;
      color: var(--accent);
    }
    ul li:first-child a {
      border-top: 0;
    }
  }
</style>
