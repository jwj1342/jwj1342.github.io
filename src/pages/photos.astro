---
import Base from '../layouts/Base.astro';
import photosData from '../data/photos.json';
import { site } from '../data/site';
import type { Photo } from '../lib/util';
import ArtBanner from '../components/ArtBanner.astro';
import parasol from '../assets/art/woman-with-a-parasol.jpg';

const photos = photosData as Photo[];

// One roll of film per year, newest first; photos with no known year go last.
const yearOf = (p: Photo) => p.year ?? (p.takenAt ? new Date(p.takenAt).getUTCFullYear() : undefined);
const byYear = new Map<number | undefined, Photo[]>();
for (const p of photos) {
  const y = yearOf(p);
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
const rolls = [...byYear.entries()]
  .sort(([a], [b]) => (b ?? -Infinity) - (a ?? -Infinity))
  .map(([year, items]) => ({ year, label: year ? String(year) : 'Undated', short: year ? String(year) : '—', id: year ? String(year) : 'undated', items }));

const caption = (p: Photo) =>
  [p.title, p.takenAt && new Date(p.takenAt).getUTCFullYear(), p.camera, p.lens, p.settings].filter(Boolean).join(' · ');
---

<Base title="Photos" description="A wall of photographs by Wenjia Jiang.">
  <ArtBanner image={parasol} title="Woman with a Parasol" focus="50% 12%" wide />
  <div class="wrap wide">
    <header class="page-head after-art">
      <p class="eyebrow">Photos</p>
      <h1>Photo wall</h1>
      <p>Things I saw and wanted to keep, one roll of film per year.</p>
    </header>

    {
      rolls.length > 0 ? (
        <div class="rolls" id="gallery">
          {rolls.map((roll) => (
            <section class="roll" aria-label={`Photos from ${roll.label}`}>
              <div class="side">
                <button class="can" type="button" aria-expanded="true" aria-controls={`roll-${roll.id}`} title="Roll the film back in">
                  <svg viewBox="0 0 64 88" aria-hidden="true">
                    <rect class="cap" x="25" y="0" width="14" height="9" rx="2" />
                    <rect class="cap" x="6" y="7" width="52" height="11" rx="3" />
                    <rect class="body" x="9" y="17" width="46" height="56" />
                    <rect class="label" x="9" y="31" width="46" height="26" />
                    <text class="year" x="32" y="49.5" text-anchor="middle">{roll.short}</text>
                    <rect class="cap" x="6" y="72" width="52" height="11" rx="3" />
                  </svg>
                  <span class="count">
                    <span class="sr-only">{roll.label}, </span>
                    {roll.items.length} {roll.items.length === 1 ? 'frame' : 'frames'}
                  </span>
                </button>
              </div>
              <div class="strip" id={`roll-${roll.id}`}>
                <div class="clip">
                  <div class="film">
                    <div class="frames">
                      {roll.items.map((p) => (
                        <a
                          class="frame"
                          href={`${site.photosBase}/${p.full}`}
                          data-pswp-width={p.fullWidth}
                          data-pswp-height={p.fullHeight}
                          data-caption={caption(p)}
                          target="_blank"
                          rel="noopener"
                          style={`--ar:${(p.width / p.height).toFixed(4)};${p.color ? `background:${p.color}` : ''}`}
                        >
                          <img
                            src={`${site.photosBase}/${p.thumb}`}
                            alt={p.title ?? ''}
                            width={p.width}
                            height={p.height}
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </section>
          ))}
        </div>
      ) : (
        <p class="empty">Photos are on their way.</p>
      )
    }
  </div>
</Base>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  // Click a canister to roll that year's film back in, or pull it out again.
  for (const can of document.querySelectorAll<HTMLButtonElement>('.can')) {
    can.addEventListener('click', () => {
      const open = can.getAttribute('aria-expanded') !== 'true';
      can.setAttribute('aria-expanded', String(open));
      can.title = open ? 'Roll the film back in' : 'Pull the film out';
      can.closest('.roll')?.classList.toggle('rolled-up', !open);
    });
  }

  if (document.getElementById('gallery')) {
    const lightbox = new PhotoSwipeLightbox({
      gallery: '#gallery',
      children: 'a.frame',
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.94,
      padding: { top: 16, bottom: 56, left: 8, right: 8 },
    });
    lightbox.on('uiRegister', () => {
      lightbox.pswp?.ui?.registerElement({
        name: 'caption',
        order: 9,
        isButton: false,
        appendTo: 'root',
        onInit: (el, pswp) => {
          el.classList.add('pswp-caption');
          pswp.on('change', () => {
            el.textContent = pswp.currSlide?.data.element?.dataset.caption ?? '';
          });
        },
      });
    });
    lightbox.init();
  }
</script>

<style>
  .wide {
    --measure: 84rem;
  }
  .rolls {
    --can-w: 3.25rem;
    --film: var(--line);
    border-top: 1px solid var(--line);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  /* ---- one year: canister on the left, its film pulled out to the right ---- */
  .roll {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    padding-bottom: clamp(1.75rem, 4vw, 3rem);
  }
  .side {
    position: relative;
  }
  .can {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: left;
  }
  .can svg {
    width: 2.5rem;
    flex-shrink: 0;
    overflow: visible;
    transition: transform 0.25s ease;
  }
  .can:hover svg {
    transform: rotate(-4deg);
  }
  .can .cap {
    fill: var(--ink);
  }
  .can .body {
    fill: var(--accent);
  }
  .can .label {
    fill: var(--accent-2);
  }
  .can .year {
    fill: var(--bg);
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .count {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* The strip opens and closes by animating its single grid row. */
  .strip {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.3, 0.9, 0.3, 1);
    min-width: 0;
  }
  .clip {
    overflow: hidden;
    min-height: 0;
  }
  .roll:global(.rolled-up) .strip {
    grid-template-rows: 0fr;
  }

  /* The film: a tinted base with a row of sprocket holes along both edges. */
  .film {
    position: relative;
    background: var(--film);
    border-radius: 0.3rem;
    padding: 1.15rem 0.5rem;
  }
  .film::before,
  .film::after {
    content: '';
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    height: 0.42rem;
    background: repeating-linear-gradient(90deg, var(--bg) 0 0.55rem, transparent 0.55rem 1.15rem);
    border-radius: 1px;
  }
  .film::before {
    top: 0.36rem;
  }
  .film::after {
    bottom: 0.36rem;
  }

  /* Justified rows: each frame grows in proportion to its aspect ratio. */
  .frames {
    --row: clamp(6.75rem, 21vw, 16rem);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.3rem, 0.7vw, 0.5rem);
  }
  .frames::after {
    /* stops the last row from stretching */
    content: '';
    flex-grow: 1000;
  }
  .frame {
    flex-grow: calc(var(--ar) * 100);
    flex-basis: calc(var(--ar) * var(--row));
    aspect-ratio: var(--ar);
    border-radius: 0.2rem;
    overflow: hidden;
    background: var(--line);
    min-width: 0;
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .frame:hover img {
    transform: scale(1.025);
  }

  .empty {
    color: var(--muted);
    font-family: var(--serif);
    font-size: 1.2rem;
  }

  /* ---- wide screens: a timeline down the left, canisters as its nodes ---- */
  @media (min-width: 52rem) {
    .roll {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 0;
    }
    /* the timeline itself */
    .side::before {
      content: '';
      position: absolute;
      left: calc(var(--can-w) / 2 - 1px);
      top: 0;
      bottom: calc(-1 * clamp(1.75rem, 4vw, 3rem));
      width: 2px;
      background: var(--line);
    }
    .roll:last-child .side::before {
      bottom: auto;
      height: 2rem;
    }
    .can {
      position: sticky;
      top: calc(var(--header-h) + 1.25rem);
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      z-index: 1;
    }
    .can svg {
      width: var(--can-w);
      /* hides the timeline behind the canister */
      background: var(--bg);
      padding-block: 0.35rem;
      box-sizing: content-box;
    }
    .count {
      background: var(--bg);
      padding: 0.1rem 0;
    }
    /* the film leader, running from the canister's mouth to the strip */
    .strip {
      position: relative;
    }
    .strip::before {
      content: '';
      position: absolute;
      right: 100%;
      top: 1.9rem;
      width: calc(7.5rem - var(--can-w) + 0.15rem);
      height: 1.5rem;
      background: var(--film);
      transform-origin: left center;
      transition: transform 0.4s cubic-bezier(0.3, 0.9, 0.3, 1);
    }
    .roll:global(.rolled-up) .strip::before {
      transform: scaleX(0);
    }
    .film {
      border-radius: 0 0.3rem 0.3rem 0.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip,
    .strip::before,
    .can svg {
      transition: none;
    }
  }

  :global(.pswp-caption) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.9rem 1rem calc(0.9rem + env(safe-area-inset-bottom));
    text-align: center;
    color: #e9e4da;
    font: 0.82rem/1.4 var(--sans);
    pointer-events: none;
  }
</style>
