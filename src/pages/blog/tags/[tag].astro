---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import LangSwitch from '../../../components/LangSwitch.astro';
import ArtBanner from '../../../components/ArtBanner.astro';
import lilies from '../../../assets/art/water-lilies-1906.jpg';
import { getPosts } from '../../../lib/util';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`Posts tagged “${tag}”`}>
  <ArtBanner image={lilies} title="Water Lilies" />
  <div class="wrap">
    <header class="page-head after-art">
      <p class="eyebrow"><a href="/blog/">← Blog</a></p>
      <h1>#{tag}</h1>
      <div class="switch"><LangSwitch /></div>
    </header>
    <div class="list">
      <PostList posts={posts} showDescription />
    </div>
  </div>
</Base>

<style>
  .eyebrow a {
    text-decoration: none;
    padding: 0.5rem 0;
    display: inline-block;
  }
  .switch {
    margin-top: 1.25rem;
  }
  .list {
    border-top: 1px solid var(--line);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    max-width: 52rem;
  }
</style>
