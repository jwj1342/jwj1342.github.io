---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import ArtBanner from '../../components/ArtBanner.astro';
import lilies from '../../assets/art/water-lilies-1906.jpg';
import { getPosts } from '../../lib/util';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base title="Blog" description="Notes by Wenjia Jiang on research, engineering and life, in English and Chinese.">
  <ArtBanner image={lilies} title="Water Lilies" />
  <div class="wrap">
    <header class="page-head after-art">
      <p class="eyebrow">Writing</p>
      <h1>Blog</h1>
      <p>Notes on research, engineering and life, written in English or Chinese. Pick a language to read everything in it.</p>
      <div class="switch"><LangSwitch /></div>
    </header>
    {
      tags.length > 0 && (
        <p class="tags">
          {tags.map((t) => (
            <a class="tag" href={`/blog/tags/${t}/`}>
              {t}
            </a>
          ))}
        </p>
      )
    }
    <div class="list">
      {posts.length > 0 ? <PostList posts={posts} showDescription /> : <p class="empty">No posts yet. The first one is on its way.</p>}
    </div>
  </div>
</Base>

<style>
  .switch {
    margin-top: 1.25rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.5rem;
  }
  .tags .tag {
    min-height: 2rem;
    padding: 0 0.65rem;
    font-size: 0.8rem;
  }
  .list {
    border-top: 1px solid var(--line);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    max-width: 52rem;
  }
  .empty {
    color: var(--muted);
    font-family: var(--serif);
    font-size: 1.2rem;
  }
</style>
