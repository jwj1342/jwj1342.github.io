---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import '../../styles/prose.css';
import Base from '../../layouts/Base.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import { formatDate, getPosts, getTranslations, htmlLang } from '../../lib/util';

export async function getStaticPaths() {
  const posts = await getPosts();
  const translations = await getTranslations();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, translation: translations.get(post.id), newer: posts[i - 1], older: posts[i + 1], translations },
  }));
}
const { post, translation, newer, older, translations } = Astro.props;
const { Content } = await render(post);
const Translated = translation ? (await render(translation)).Content : null;
const orig = post.data.lang;
const other = orig === 'zh' ? 'en' : 'zh';

// Both languages of a neighbouring post's title, for the pager.
const titles = (p: typeof post) => ({ orig: p.data.lang, title: p.data.title, tr: translations.get(p.id) });
---

<Base title={post.data.title} description={post.data.description} ogType="article">
  <article class="wrap">
    <header class="post-head">
      <div class="top">
        <p class="eyebrow"><a href="/blog/">← Blog</a></p>
        {translation && <LangSwitch orig={orig} />}
      </div>
      <h1 data-i18n data-orig={orig} data-single={!translation}>
        <span data-l={orig} lang={htmlLang(orig)}>{post.data.title}</span>
        {translation && <span data-l={other} lang={htmlLang(other)}>{translation.data.title}</span>}
      </h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.updated && <span>· Updated {formatDate(post.data.updated)}</span>}
        {post.data.draft && <span class="tag">Draft</span>}
        {post.data.tags.map((t) => <a class="tag" href={`/blog/tags/${t}/`}>{t}</a>)}
      </p>
    </header>

    <div data-i18n data-orig={orig} data-single={!translation}>
      <div class="prose" data-l={orig} lang={htmlLang(orig)}>
        <Content />
      </div>
      {
        Translated && (
          <div class="prose" data-l={other} lang={htmlLang(other)}>
            <p class="tr-note">
              {other === 'en' ? (
                <>
                  Translated from Chinese by AI.{' '}
                  <button type="button" data-set-lang="zh">Read the original</button>
                </>
              ) : (
                <>
                  本文由 AI 从英文翻译。
                  <button type="button" data-set-lang="en">阅读原文</button>
                </>
              )}
            </p>
            <Translated />
          </div>
        )
      }
    </div>

    {
      (newer || older) && (
        <nav class="pager" aria-label="More posts">
          {[older, newer].map((p, n) =>
            p ? (
              <a class={n === 1 ? 'next' : undefined} href={`/blog/${p.id}/`}>
                <small>{n === 0 ? '← Older' : 'Newer →'}</small>
                <span data-i18n data-orig={titles(p).orig} data-single={!titles(p).tr}>
                  <span data-l={titles(p).orig} lang={htmlLang(titles(p).orig)}>{titles(p).title}</span>
                  {titles(p).tr && (
                    <span data-l={titles(p).tr!.data.lang} lang={htmlLang(titles(p).tr!.data.lang)}>
                      {titles(p).tr!.data.title}
                    </span>
                  )}
                </span>
              </a>
            ) : (
              <span />
            ),
          )}
        </nav>
      )
    }
  </article>
</Base>

<script>
  // Diagrams: the Mermaid library is fetched only by posts that have a ```mermaid block.
  const diagrams = [...document.querySelectorAll<HTMLElement>('.prose pre[data-language="mermaid"]')];
  if (diagrams.length) void import('../../scripts/mermaid-blocks').then((m) => m.start(diagrams));
</script>

<style>
  .post-head {
    max-width: var(--prose);
    padding-block: clamp(2.25rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .top .eyebrow {
    margin: 0;
  }
  .eyebrow a {
    text-decoration: none;
    padding: 0.5rem 0;
    display: inline-block;
  }
  /* note at the top of a machine translation */
  .tr-note {
    font-family: var(--sans);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
    border-left: 2px solid var(--line);
    padding-left: 0.8rem;
    text-align: start;
  }
  .tr-note button {
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  /* Chinese titles: a size down, with room between lines */
  h1 :lang(zh) {
    font-size: 0.82em;
    letter-spacing: 0;
    line-height: 1.3;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .pager {
    max-width: var(--prose);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
    padding: 0.5rem 0;
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.35;
  }
  .pager small {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (min-width: 36rem) {
    .pager {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
    }
    .pager .next {
      text-align: right;
    }
  }
</style>
