---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import '../../styles/prose.css';
import Base from '../../layouts/Base.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import { formatDate, getPosts, getTranslations, htmlLang } from '../../lib/util';

export async function getStaticPaths() {
  const posts = await getPosts();
  const translations = await getTranslations();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, translation: translations.get(post.id), newer: posts[i - 1], older: posts[i + 1], translations },
  }));
}
const { post, translation, newer, older, translations } = Astro.props;
const rendered = await render(post);
const renderedTr = translation ? await render(translation) : null;
const { Content } = rendered;
const Translated = renderedTr ? renderedTr.Content : null;
const orig = post.data.lang;
const other = orig === 'zh' ? 'en' : 'zh';

// The table of contents beside the post on wide screens: its h2 and h3 headings, in each
// language. A post with only a couple of headings goes without one.
type Heading = { depth: number; slug: string; text: string };
const sections = (headings: Heading[]) => headings.filter((h) => h.depth === 2 || h.depth === 3);
const contents = sections(rendered.headings);
const contentsTr = renderedTr ? sections(renderedTr.headings) : [];
const hasToc = contents.length >= 3;

// Both languages of a neighbouring post's title, for the pager.
const titles = (p: typeof post) => ({ orig: p.data.lang, title: p.data.title, tr: translations.get(p.id) });
---

<Base title={post.data.title} description={post.data.description} ogType="article">
  <article class="wrap">
    <header class="post-head">
      <div class="top">
        <p class="eyebrow"><a href="/blog/">← Blog</a></p>
        {translation && <LangSwitch orig={orig} />}
      </div>
      <h1 data-i18n data-orig={orig} data-single={!translation}>
        <span data-l={orig} lang={htmlLang(orig)}>{post.data.title}</span>
        {translation && <span data-l={other} lang={htmlLang(other)}>{translation.data.title}</span>}
      </h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.updated && <span>· Updated {formatDate(post.data.updated)}</span>}
        {post.data.draft && <span class="tag">Draft</span>}
      </p>
    </header>

    <div class:list={['post-body', { 'with-toc': hasToc }]}>
    <div data-i18n data-orig={orig} data-single={!translation}>
      <div class="prose" data-l={orig} lang={htmlLang(orig)}>
        <Content />
      </div>
      {
        Translated && (
          <div class="prose" data-l={other} lang={htmlLang(other)}>
            <p class="tr-note">
              {other === 'en' ? (
                <>
                  Translated from Chinese by AI.{' '}
                  <button type="button" data-set-lang="zh">Read the original</button>
                </>
              ) : (
                <>
                  本文由 AI 从英文翻译。
                  <button type="button" data-set-lang="en">阅读原文</button>
                </>
              )}
            </p>
            <Translated />
          </div>
        )
      }
    </div>
    {
      hasToc && (
        <nav class="toc" aria-label="On this page" data-toc>
          <p class="toc-title">On this page</p>
          <div data-i18n data-orig={orig} data-single={!translation}>
            <ol data-l={orig} lang={htmlLang(orig)}>
              {contents.map((h) => (
                <li class:list={{ sub: h.depth === 3 }}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
            {translation && (
              <ol data-l={other} lang={htmlLang(other)}>
                {contentsTr.map((h) => (
                  <li class:list={{ sub: h.depth === 3 }}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </div>
        </nav>
      )
    }
    </div>

    {
      (newer || older) && (
        <nav class="pager" aria-label="More posts">
          {[older, newer].map((p, n) =>
            p ? (
              <a class={n === 1 ? 'next' : undefined} href={`/blog/${p.id}/`}>
                <small>{n === 0 ? '← Older' : 'Newer →'}</small>
                <span data-i18n data-orig={titles(p).orig} data-single={!titles(p).tr}>
                  <span data-l={titles(p).orig} lang={htmlLang(titles(p).orig)}>{titles(p).title}</span>
                  {titles(p).tr && (
                    <span data-l={titles(p).tr!.data.lang} lang={htmlLang(titles(p).tr!.data.lang)}>
                      {titles(p).tr!.data.title}
                    </span>
                  )}
                </span>
              </a>
            ) : (
              <span />
            ),
          )}
        </nav>
      )
    }
  </article>
</Base>

<script>
  // Diagrams: the Mermaid library is fetched only by posts that have a ```mermaid block.
  const diagrams = [...document.querySelectorAll<HTMLElement>('.prose pre[data-language="mermaid"]')];
  if (diagrams.length) void import('../../scripts/mermaid-blocks').then((m) => m.start(diagrams));

  // Table of contents: mark the section being read. Only the links that are on screen
  // count (the other language's list is hidden, and so is the whole thing on a narrow page).
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    let waiting = false;
    const mark = () => {
      waiting = false;
      const shown = links.filter((a) => a.offsetParent);
      let current: HTMLAnchorElement | undefined;
      for (const a of shown) {
        const heading = document.getElementById(decodeURIComponent(a.hash.slice(1)));
        // a section starts being "read" when its heading has come up under the header
        if (heading && heading.getBoundingClientRect().top <= 130) current = a;
      }
      // at the very bottom the last sections may be too short to reach the top
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) current = shown[shown.length - 1];
      for (const a of links) {
        if (a === current) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
    };
    addEventListener(
      'scroll',
      () => {
        if (!waiting) {
          waiting = true;
          requestAnimationFrame(mark);
        }
      },
      { passive: true },
    );
    addEventListener('resize', mark);
    // the reader switched language: the other list is showing now
    new MutationObserver(mark).observe(document.documentElement, { attributes: true, attributeFilter: ['data-blog-lang'] });
    mark();
  }
</script>

<style>
  .post-head {
    max-width: var(--prose);
    padding-block: clamp(2.25rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .top .eyebrow {
    margin: 0;
  }
  .eyebrow a {
    text-decoration: none;
    padding: 0.5rem 0;
    display: inline-block;
  }
  /* note at the top of a machine translation */
  .tr-note {
    font-family: var(--sans);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
    border-left: 2px solid var(--line);
    padding-left: 0.8rem;
    text-align: start;
  }
  .tr-note button {
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  /* Chinese titles: a size down, with room between lines */
  h1 :lang(zh) {
    font-size: 0.82em;
    letter-spacing: 0;
    line-height: 1.3;
  }
  /* On a wide screen the text keeps its comfortable line length and the space to its
     right holds a table of contents; on anything narrower the contents are left out. */
  .toc {
    display: none;
  }
  @media (min-width: 68rem) {
    .post-body.with-toc {
      display: grid;
      grid-template-columns: minmax(0, var(--prose)) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: start;
    }
    .toc {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      max-height: calc(100vh - var(--header-h) - 4rem);
      overflow-y: auto;
      justify-self: end;
      width: min(100%, 15rem);
      font-size: 0.84rem;
      line-height: 1.4;
    }
  }
  .toc-title {
    margin: 0 0 0.7rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .toc a {
    display: block;
    margin-left: -1px;
    padding: 0.32rem 0 0.32rem 0.9rem;
    border-left: 1px solid transparent;
    color: var(--muted);
    text-decoration: none;
  }
  .toc .sub a {
    padding-left: 1.7rem;
    font-size: 0.8rem;
  }
  .toc a:hover {
    color: var(--ink);
  }
  .toc a[aria-current='true'] {
    color: var(--ink);
    border-left-color: var(--accent);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .pager {
    max-width: var(--prose);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
    padding: 0.5rem 0;
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.35;
  }
  .pager small {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (min-width: 36rem) {
    .pager {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
    }
    .pager .next {
      text-align: right;
    }
  }
</style>
